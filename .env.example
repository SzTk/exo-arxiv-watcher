# Copy this file to .env and edit as needed.
# Real environment variables always take precedence over .env values.

# Local llamafile / llama.cpp backend (OpenAI-compatible API, default)
MODEL_ID=openai:Qwen2.5-7B-Instruct-Q8_0
API_BASE=http://localhost:8080/v1
API_KEY=whatever

# Cloud backend example — Anthropic API directly (any-llm-sdk's `anthropic`
# provider uses the official Anthropic SDK client, so x-api-key /
# anthropic-version headers are added automatically). MODEL_ID must be in
# `anthropic:<model>` form; API_BASE is only needed to point at a relay
# instead of api.anthropic.com.
# MODEL_ID=anthropic:claude-sonnet-5
# API_KEY=<your-anthropic-api-key>

# Cloud backend example — via a relay/proxy exposing an Anthropic-compatible
# /v1/messages endpoint (no /v1 suffix — the SDK adds it):
# MODEL_ID=anthropic:claude-sonnet-5
# API_BASE=https://your-relay.example.workers.dev
# API_KEY=<your-relay-api-key>
